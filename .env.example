# PHIRST2 environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PHIRST_LOG_LEVEL=info

# Database (PostgreSQL 14+)
DATABASE_URL=postgres://phirst:CHANGE_ME@localhost:5432/phirst
# Isolated database for the integration tests. Created by scripts/test-db-setup.sh.
TEST_DATABASE_URL=postgres://phirst:CHANGE_ME@localhost:5432/phirst_test

# Secrets. Generate each with: openssl rand -base64 32
# PHIRST_MASTER_KEY MUST decode to exactly 32 bytes or the API refuses to start.
PHIRST_MASTER_KEY=
PHIRST_SESSION_SECRET=

# API / web
PHIRST_API_PORT=12001
PHIRST_WEB_ORIGIN=https://your-host.example

# Trading engine
PHIRST_ENGINE_TICK_MS=1000
PHIRST_PAPER_BALANCE=10000

# AI (Google Gemini). Leave GEMINI_API_KEY empty to run without AI analysis.
GEMINI_API_KEY=
PHIRST_GEMINI_MODEL=gemini-3.5-flash
PHIRST_GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-pro

# Market data (Twelve Data). Used for quotes, historical candles and the instrument list.
# Leave TWELVE_DATA_API_KEY empty to fall back to the broker's own market-data feed.
TWELVE_DATA_API_KEY=
# Which provider supplies market data: "deriv" (broker feed, default) or "twelve_data".
PHIRST_MARKET_DATA_PROVIDER=deriv

# Transactional email (Resend). RESEND_FROM must be an address on a domain verified in
# the Resend dashboard, or the shared sender onboarding@resend.dev for testing.
RESEND_API_KEY=
RESEND_FROM="Wein <onboarding@resend.dev>"
RESEND_REPLY_TO=

# Supabase (authentication and platform data). SUPABASE_SERVICE_ROLE_KEY is server-only:
# never expose it to the browser and never commit it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Deriv (broker). The app id is issued when an application is registered on the Deriv
# dashboard. It is required for authenticated (PAT) requests and is also the OAuth2
# client_id. Public market data needs no app id at all.
DERIV_APP_ID=

# Deriv OAuth 2.0 (one-tap "Connect Deriv"). Deriv issues the OAuth2 client_id as the same
# value as DERIV_APP_ID; DERIV_OAUTH_REDIRECT_URI must match the registered value exactly
# (scheme, host, port and path). Defaults to <PHIRST_WEB_ORIGIN>/api/deriv/oauth/callback.
# DERIV_OAUTH_SCOPES defaults to the minimum needed for trading ("trade").
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_REDIRECT_URI=
DERIV_OAUTH_SCOPES=trade

# Telegram remote control. Leave the token empty to disable the integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
