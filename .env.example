# PHIRST2 environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PHIRST_LOG_LEVEL=info

# Database (PostgreSQL 14+)
DATABASE_URL=postgres://phirst:CHANGE_ME@localhost:5432/phirst
# Isolated database for the integration tests. Created by scripts/test-db-setup.sh.
TEST_DATABASE_URL=postgres://phirst:CHANGE_ME@localhost:5432/phirst_test

# Secrets. Generate each with: openssl rand -base64 32
# PHIRST_MASTER_KEY MUST decode to exactly 32 bytes or the API refuses to start.
PHIRST_MASTER_KEY=
PHIRST_SESSION_SECRET=

# API / web
PHIRST_API_PORT=12001
PHIRST_WEB_ORIGIN=https://your-host.example

# Trading engine
PHIRST_ENGINE_TICK_MS=1000
PHIRST_PAPER_BALANCE=10000

# AI (Google Gemini). Leave GEMINI_API_KEY empty to run without AI analysis.
GEMINI_API_KEY=
PHIRST_GEMINI_MODEL=gemini-3.5-flash
PHIRST_GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest

# Deriv (broker). Public app id 1089 works for read-only market data.
DERIV_APP_ID=1089

# Telegram remote control. Leave the token empty to disable the integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
